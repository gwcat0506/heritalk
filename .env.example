# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# 시드 스크립트(scripts/seed-*.ts) 전용 — 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Kakao 지도 (표시) ─────────────────────────────────────
# Kakao Developers > 내 애플리케이션 > JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_KEY=YOUR-KAKAO-JS-KEY

# ── TMap 보행자 경로 (도보 경로·시간) ────────────────────
# SK open API (TMap) AppKey — 서버에서만 사용
TMAP_APP_KEY=YOUR-TMAP-APP-KEY

# ── Google Gemini (채팅 도슨트 + 임베딩) ─────────────────
GOOGLE_GENERATIVE_AI_API_KEY=YOUR-GOOGLE-AI-KEY
